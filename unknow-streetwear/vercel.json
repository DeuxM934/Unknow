
{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "^/style\\.css$",
      "dest": "/style.css"
    },
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|svg|webp|ico|woff2?))$",
      "dest": "/$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1.php"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}
